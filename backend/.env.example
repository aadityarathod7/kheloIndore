# Copy this file to backend/.env and fill in deployment-specific values.
# Never commit backend/.env or real credentials.

PORT=4000
NODE_ENV=development
JWT_AUTH=replace-with-a-long-random-jwt-secret
MONGODB_URI=mongodb://127.0.0.1:27017/kheloindore
WEBSITE_URL=http://localhost:3000
REDIRECT_API_URL=http://localhost:4000
REDIRECT_URL=http://localhost:3000/payment-success
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Cashfree payment gateway
CASHFREE_ENV=sandbox
CASHFREE_BASE_URL=https://sandbox.cashfree.com/pg
CASHFREE_API_VERSION=2023-08-01
CASHFREE_APP_ID=replace-with-cashfree-app-id
CASHFREE_SECRET_KEY=replace-with-cashfree-secret-key

# BhashSMS transactional OTP
BHASH_SMS_API_URL=https://bhashsms.com/api/sendmsg.php
BHASH_SMS_USER=replace-with-sms-username
BHASH_SMS_PASSWORD=replace-with-sms-password
BHASH_SMS_SENDER_ID=replace-with-approved-sender-id
BHASH_OTP_CHANNELS=sms,whatsapp
BHASH_WHATSAPP_API_URL=https://bhashsms.com/api/sendmsg.php
BHASH_WHATSAPP_SENDER_ID=replace-with-approved-whatsapp-sender-id
BHASH_WHATSAPP_OTP_TEMPLATE=replace-with-approved-template-name

# Email / notification integrations
SMTP_USER=replace-with-smtp-username
SMTP_PASS=replace-with-smtp-password
SUPER_ADMIN_EMAIL=admin@example.com
CODE_COCKTAILS_AUTH_TOKEN=replace-with-a-long-random-token