# BhashSMS transactional SMS credentials (given in the BhashSMS panel)
BHASH_SMS_API_URL=https://bhashsms.com/api/sendmsg.php
BHASH_SMS_USER=Surendra_SMS
BHASH_SMS_PASSWORD=123456
BHASH_SMS_SENDER_ID=KheloIndor

# Send through one or both channels: sms, whatsapp, or sms,whatsapp
BHASH_OTP_CHANNELS=sms,whatsapp

# BhashSMS WhatsApp authentication-OTP API details.
# The sender is usually BUZWAP. The template name must be approved by WhatsApp.
BHASH_WHATSAPP_API_URL=https://bhashsms.com/api/sendmsg.php
BHASH_WHATSAPP_SENDER_ID=BUZWAP
BHASH_WHATSAPP_OTP_TEMPLATE=

# Static bearer token used by the external "Code and Cocktails" guest form
# (keep it long & random; fallback value exists in code but should be overridden)
CODE_COCKTAILS_AUTH_TOKEN=change-me-to-a-long-random-string
