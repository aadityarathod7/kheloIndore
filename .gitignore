# Root .gitignore for Khelo Indore Monorepo

# Ignore node_modules in all subfolders
node_modules/
backend/node_modules/
frontend-website/node_modules/
frontend-admin/node_modules/

# Ignore local environment variables and secret keys
.env
.env.local
backend/.env

# Ignore user uploads and pdf outputs (keep placeholders)
backend/public/uploads/*
!backend/public/uploads/.gitkeep
backend/public/pdf/*
!backend/public/pdf/.gitkeep

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# System Files
.DS_Store
Thumbs.db
*.map
